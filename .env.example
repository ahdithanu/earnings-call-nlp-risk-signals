# Copy to .env (never commit it). Everything in the project runs without
# secrets except the features each key below unlocks.

# Price-outcomes fetch (post-call drift). Either provider works.
FMP_API_KEY=your_financialmodelingprep_key_here
# ALPHAVANTAGE_API_KEY also enables direct-from-API transcript ingestion
# for the /ask retrieval index (scripts/fetch_av_transcripts.py).
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# Generative /ask mode (generate=true): Claude composes a cited answer from
# the retrieved excerpts. Without it, /ask serves the deterministic
# extractive answer and generate=true returns 503.
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional override of the generation model (default: claude-opus-5-5).
# ASK_LLM_MODEL=claude-opus-5-5
